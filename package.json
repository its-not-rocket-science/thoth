    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "jsdom": "^25.0.1",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
